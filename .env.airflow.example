# Modèle de .env.airflow, lu par Docker Compose :
#   docker compose -f docker-compose.airflow.yml --env-file .env.airflow up -d --build
#
# Copiez ce fichier en .env.airflow sur la machine de prod et remplissez les secrets :
# sans eux, Compose refuse de démarrer. .env.airflow n'est jamais versionné ; sur le
# serveur, il n'est lisible que par son propriétaire (chmod 600, ADR-0008).

# --- Application à réentraîner (mêmes valeurs que .env.prod) ---
# Version de l'image de prod publiée par la CD.
APP_VERSION=
# MongoDB de l'ERP, compte en lecture seule (voir .env.prod.example).
TRAINING_SOURCE_URL=

# --- Réentraînement (ADR-0010) ---
# Nouvelles commandes labellisées nécessaires pour lancer un entraînement.
RETRAIN_MIN_NEW_ORDERS=100
# Planification (cron) : chaque nuit à 2 h.
RETRAIN_SCHEDULE=0 2 * * *
# Le nouveau modèle remplace le modèle en service si cette métrique le dépasse d'au
# moins ce gain, sur le même jeu de test.
PROMOTION_METRIC=f1_score
PROMOTION_MIN_GAIN=0.0

# --- Secrets d'Airflow ---
# Mot de passe du compte admin de l'interface.
AIRFLOW_ADMIN_PASSWORD=
# Mot de passe de la base PostgreSQL des métadonnées d'Airflow.
AIRFLOW_DB_PASSWORD=
# Chiffre les connexions et variables stockées par Airflow. Pour en générer une :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Signent les jetons entre les composants d'Airflow, et les sessions de l'interface.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=

# --- Port publié sur la machine (127.0.0.1 uniquement) ---
AIRFLOW_PORT=8080
