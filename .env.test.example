# Modèle de .env.test, lu par Docker Compose :
#   docker compose -f docker-compose.test.yml --env-file .env.test up -d --build
#
# Copiez ce fichier en .env.test sur la machine de test et remplissez les mots de
# passe : sans eux, Compose refuse de démarrer. .env.test n'est jamais versionné.
# Mots de passe propres au test : jamais ceux du dev ni de la prod (ADR-0008).

# --- Modèle ---
MODEL_THRESHOLD=0.5
MODEL_VERSION=1.0.0
RANDOM_SEED=42

# --- Logs ---
LOG_LEVEL=INFO

# --- MongoDB de test (ADR-0009) ---
# Administrateur, utilisé seulement pour l'administration.
MONGO_ROOT_PASSWORD=
# Compte en lecture seule de l'entraînement.
MONGO_TRAINING_PASSWORD=
# Compte de l'ETL simulé, qui alimente la base.
MONGO_ETL_PASSWORD=

# --- ETL simulé ---
ETL_HISTORY_ORDERS=3000
ETL_BATCH_SIZE=5
ETL_INTERVAL_SECONDS=5
# 0 : flux illimité.
ETL_LIVE_ORDER_LIMIT=0

# --- Ports publiés sur la machine (127.0.0.1 uniquement) ---
API_PORT=8001
MLFLOW_PORT=5001
