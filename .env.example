# Copier ce fichier en .env puis adapter les valeurs.

# dev  : base SQLite (data/commandes.db)
# prod : base PostgreSQL (variables POSTGRES_* ci-dessous)
APP_ENV=dev

# Conteneurs lancés par docker compose : mettre la même valeur que APP_ENV.
# Le conteneur PostgreSQL ne démarre qu'avec prod.
COMPOSE_PROFILES=dev

# Serveur MLflow vu depuis la machine (dans Docker, l'API utilise http://mlflow:5000).
MLFLOW_TRACKING_URI=http://localhost:5000

# PostgreSQL (APP_ENV=prod). Depuis la machine (outils) : localhost et le port publié.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=commandes
POSTGRES_USER=commandes_user
POSTGRES_PASSWORD=change-me

# Ports publiés sur la machine.
API_PORT=8000
MLFLOW_PORT=5000
