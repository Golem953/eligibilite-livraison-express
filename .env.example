# Copiez ce fichier en .env pour lancer l'application sans Docker.
#
# Chaque valeur par défaut est dans src/app/config.py, où elle est documentée : une
# clé laissée VIDE ci-dessous prend cette valeur par défaut. Remplir une clé la
# remplace, sans toucher au code. N'ajoutez pas de clé que config.py ne connaît pas :
# l'application refuserait de démarrer.

# --- Modèle ---
# Chemin du fichier .joblib écrit par `train` et lu par l'API (cellule 41 du notebook).
MODEL_PATH=

# Seuil de probabilité au-delà duquel une commande est éligible (cellule 31).
MODEL_THRESHOLD=

# Version du modèle, renvoyée avec chaque prédiction (ADR-0002).
MODEL_VERSION=

# Graine aléatoire de la génération des données et de l'entraînement.
RANDOM_SEED=

# --- Logs ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
