# Modèle des fichiers .env.dev et .env.prod (non versionnés).
# Lancement : docker compose --env-file .env.dev up -d --build

# Conteneurs lancés par docker compose : sqlite | postgresql
# (postgresql lance le service db, sqlite n'en lance aucun)
DATABASE=sqlite
COMPOSE_PROFILES=${DATABASE}

# URL utilisée par l'application (ADR-0001), cohérente avec DATABASE :
DATABASE_URL=sqlite:///data/commandes.db
# PostgreSQL, depuis docker compose :
# DATABASE_URL=postgresql://commandes_user:changeme@db:5432/commandes
# PostgreSQL de docker compose, depuis ta machine (port publié 8058) :
# DATABASE_URL=postgresql://commandes_user:changeme@localhost:8058/commandes

# Identifiants du service db (DATABASE=postgresql)
POSTGRES_USER=commandes_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=commandes
