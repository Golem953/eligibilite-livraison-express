# Copy this file to .env.
#
# In this correction, every default lives in src/livraison_express/config.py (each one
# documented there): a key left EMPTY below means "use that default". Filling a key
# overrides it, without touching the code. Keys are read by config.py (session 1).

# --- General ---
# environment: local | test | prod. Read it to switch behaviour without touching the code.
ENVIRONMENT=

# --- Model ---
# Path to the .joblib file produced by the notebook (cell 41).
MODEL_PATH=

# URI du modèle enregistré dans MLflow (ex. runs:/<run_id>/model).
MLFLOW_MODEL_URI=

# Decision threshold above which an order is considered eligible (cell 31).
MODEL_THRESHOLD=

# Version of the model served by the API. Carried by the configuration in session 1
# and read from the model card of the artifact from session 3 (ADR-0002).
MODEL_VERSION=

# --- Data store ---
# Connection string or path of the store you implement for your OrderStore adapter.
# Examples: postgresql://user:password@localhost:5432/livraison_express
#           redis://localhost:6379/0
#           sqlite:///./local.db
ORDER_STORE_DSN=

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=
