# Modèle de .env.prod, lu par Docker Compose :
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Copiez ce fichier en .env.prod sur le serveur de prod. .env.prod n'est jamais
# versionné : il contient le mot de passe du MongoDB des analystes et les secrets d'Airflow. Sur le serveur, il
# n'est lisible que par son propriétaire (chmod 600, ADR-0007).

# --- Image ---
# Version publiée par la CD sur ghcr.io (tag Git v<version>).
APP_VERSION=

# --- Modèle ---
MODEL_THRESHOLD=0.5
MODEL_VERSION=1.0.0
RANDOM_SEED=42

# Canary du modèle (ADR-0005) : part des commandes (0 à 100) prédite par le modèle
# canary, et sa version. Changer CANARY_PERCENT, puis `up -d api` (pas `restart`).
CANARY_PERCENT=0
CANARY_MODEL_VERSION=canary

# --- Logs ---
LOG_LEVEL=INFO

# --- MongoDB des analystes (ADR-0009) ---
# Service externe, alimenté par l'ERP dans un seul sens. Compte en lecture seule, créé
# par l'équipe avec le compte administrateur transmis par l'alternant :
#   mongodb://training_reader:<mot de passe>@<adresse du MongoDB>:27017/livraison_express
# Simulé sur le même poste (erp_prod_test, MONGO_PORT=27117), tant que ce MongoDB n'a
# pas d'authentification :
#   mongodb://host.docker.internal:27117/livraison_express
TRAINING_SOURCE_URL=

# --- Ports publiés sur la machine (127.0.0.1 uniquement) ---
API_PORT=8000
MLFLOW_PORT=5000
AIRFLOW_PORT=8080

# --- Réentraînement (ADR-0010) ---
# Nouvelles commandes labellisées nécessaires pour lancer un entraînement.
RETRAIN_MIN_NEW_ORDERS=100
# Planification (cron) : chaque nuit à 2 h.
RETRAIN_SCHEDULE=0 2 * * *
# Le nouveau modèle remplace le modèle en service si cette métrique le dépasse d'au
# moins ce gain, sur le même jeu de test.
PROMOTION_METRIC=f1_score
PROMOTION_MIN_GAIN=0.0

# --- Secrets d'Airflow ---
# Mot de passe du compte admin de l'interface.
AIRFLOW_ADMIN_PASSWORD=
# Mot de passe de la base PostgreSQL des métadonnées d'Airflow.
AIRFLOW_DB_PASSWORD=
# Chiffre les connexions et variables stockées par Airflow. Pour en générer une :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Signent les jetons entre les composants d'Airflow, et les sessions de l'interface.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
