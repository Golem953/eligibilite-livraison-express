# Modèle de .env.prod, lu par Docker Compose :
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Copiez ce fichier en .env.prod sur le serveur de prod. .env.prod n'est jamais
# versionné : il contient le mot de passe de la base de l'ERP. Sur le serveur, il
# n'est lisible que par son propriétaire (chmod 600, ADR-0008).

# --- Image ---
# Version publiée par la CD sur ghcr.io (tag Git v<version>).
APP_VERSION=

# --- Modèle ---
MODEL_THRESHOLD=0.5
MODEL_VERSION=1.0.0
RANDOM_SEED=42

# --- Logs ---
LOG_LEVEL=INFO

# --- MongoDB de l'ERP (ADR-0009) ---
# Service externe, sur la machine de l'ERP. Compte en lecture seule, à créer avec le
# mainteneur de l'ERP :
#   mongodb://training_reader:<mot de passe>@<adresse de l'ERP>:27017/livraison_express
# ERP simulé sur le même poste (MONGO_PORT=27117), tant que son MongoDB n'a pas
# d'authentification :
#   mongodb://host.docker.internal:27117/livraison_express
TRAINING_SOURCE_URL=

# --- Ports publiés sur la machine (127.0.0.1 uniquement) ---
API_PORT=8000
MLFLOW_PORT=5000
